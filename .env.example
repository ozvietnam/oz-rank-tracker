# OZ Rank Tracker — bien moi truong (set tren Vercel: Settings -> Environment Variables)
# App van chay khi thieu cac bien nay (fallback localStorage, tinh nang lien quan tat).

# --- Phase 0: Bao mat API (khuyen nghi bat) ---
APP_TOKEN=                     # Chuoi ngau nhien. Khi set, moi request /api/* phai kem token
                               # (nhap qua nut 🔑 tren dashboard). Bo trong = API mo nhu cu.

# --- Phase 1: SerpAPI (bat buoc de check rank) ---
SERP_API_KEY=
TARGET_DOMAIN=thutucxuatnhapkhau.com

# --- Phase 2: Supabase (dong bo da thiet bi + lich su rank) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=          # Service role key (Project Settings -> API). GIU BI MAT.

# --- Phase 3: Cron + Telegram (auto check + canh bao) ---
CRON_SECRET=                   # Chuoi ngau nhien; Vercel cron gui kem de xac thuc.
TELEGRAM_BOT_TOKEN=            # Tao bot qua @BotFather
TELEGRAM_CHAT_ID=             # Chat/group ID nhan canh bao
ALERT_DROP_THRESHOLD=3         # Canh bao khi rank tut tu N bac tro len
CHECK_INTERVAL_DAYS=3          # Tu khoa thuong check moi N ngay (tu khoa ⭐ check hang ngay)
CRON_TIME_BUDGET_MS=45000      # Ngan sach thoi gian moi lan cron chay (tranh timeout Vercel)
WEEKLY_DIGEST_DAY=1            # Ngay gui digest tuan qua Telegram (0=CN, 1=thu Hai... theo UTC)

# --- Phase 3 (tuy chon): Google Search Console (auto clicks/impressions/position) ---
GSC_CLIENT_EMAIL=             # email service account ...@...iam.gserviceaccount.com
GSC_PRIVATE_KEY=              # private key (giu nguyen \n hoac dan ca khoi co xuong dong)
GSC_SITE_URL=https://thutucxuatnhapkhau.com/

# --- Phase 4 (tuy chon): Webhook leads tu form website ---
LEAD_WEBHOOK_SECRET=           # Secret cho POST /api/lead (fallback dung APP_TOKEN neu bo trong)
